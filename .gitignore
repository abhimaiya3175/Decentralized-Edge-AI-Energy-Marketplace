# ==============================================================================
# SECRETS & ENVIRONMENT FILES (STRICT - NEVER COMMIT KEYS OR CREDENTIALS)
# ==============================================================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
**/.env
**/.env.*
**/*.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Allow committed example environment templates
!**/.env.example

# Private Keys, Certificates, & Sensitive Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.keystore
secrets.json
credentials.json
alchemy_key.txt
infura_key.txt

# ==============================================================================
# NODE.JS & DEPENDENCY DIRECTORIES
# ==============================================================================
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# NEXT.JS & FRONTEND BUILD ARTIFACTS
# ==============================================================================
.next/
*/.next/
**/.next/
out/
*/out/
**/out/
.vercel
next-env.d.ts

# ==============================================================================
# HARDHAT & SMART CONTRACT ARTIFACTS
# ==============================================================================
cache/
*/cache/
**/cache/
artifacts/
*/artifacts/
**/artifacts/
typechain/
typechain-types/

# ==============================================================================
# PYTHON CACHE & ARTIFACTS
# ==============================================================================
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
*.pyo
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.pkl
*.joblib

# ==============================================================================
# SYSTEM & EDITOR ARTIFACTS
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

